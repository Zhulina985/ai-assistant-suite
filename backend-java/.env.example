# 复制本文件为 .env 并填写（不要把 .env 提交到 Git）

# MySQL 数据库（账户 root，密码请填在下一行）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=speaking_coach
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here

# OpenRouter / OpenAI 兼容 API
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
