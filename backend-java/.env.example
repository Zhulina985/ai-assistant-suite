# 复制本文件为 .env 并填写（不要把 .env 提交到 Git）
# Windows 可运行 setup-tools.bat 自动复制

# MySQL 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=speaking_coach
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here

# OpenRouter / OpenAI 兼容 API（可选，不填则演示模式）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
